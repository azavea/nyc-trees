description	"nyc-trees-celery"

{% if ['development', 'test'] | some_are_in(group_names) -%}
start on (vagrant-mounted)
{% else %}
start on (local-filesystems and net-device-up IFACE!=lo)
{% endif %}
stop on shutdown

respawn
setuid nyc-trees
chdir {{ app_home }}

exec envdir /etc/nyc-trees.d/env celery -A "nyc_trees.celery:app" worker -l {{ celery_log_level }} >> {{ celery_log }} 2>&1
